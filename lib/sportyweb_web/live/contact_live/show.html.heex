<.header>
  {@page_title}
  <:actions>
    <a href={~p"/contacts/#{@contact}/export"}>
      <.button>Daten exportieren</.button>
    </a>
    <.link navigate={~p"/contacts/#{@contact}/edit"}>
      <.button>Kontakt bearbeiten</.button>
    </.link>
  </:actions>
</.header>

<.card>
  <.list>
    <:item title="Art">
      {get_key_for_value(Contact.get_valid_types(), @contact.type)}
    </:item>
    <:item title="Name">
      {format_string_field(@contact.name)}
    </:item>
    <:item :if={Contact.is_organization?(@contact)} title="Organisationstyp">
      {get_key_for_value(Contact.get_valid_organization_types(), @contact.organization_type)}
    </:item>
    <:item :if={Contact.is_person?(@contact)} title="Geschlecht">
      {get_key_for_value(Contact.get_valid_genders(), @contact.person_gender)}
    </:item>
    <:item :if={Contact.is_person?(@contact)} title="Geburtsdatum">
      {format_date_field_dmy(@contact.person_birthday)} - {Contact.age_in_years(@contact)} Jahre
    </:item>
    <:item title="Adresse">
      {format_string_field(@contact.email)}
      <SportywebWeb.PolymorphicLive.PostalAddressesShowComponent.render postal_addresses={[
        @contact.address
      ]} />
    </:item>
    <:item title="E-Mail">
      {format_string_field(@contact.email)}
    </:item>
    <:item title="Telefon">
      {format_string_field(@contact.phone)}
    </:item>
    <:item title="Zahlungsdaten">
      <SportywebWeb.PolymorphicLive.FinancialDataShowComponent.render financial_data={[
        @contact.financial_data
      ]} />
    </:item>
    <:item title="Notizen">
      {format_string_field(@contact.note)}
    </:item>
    <:item :if={Contact.has_active_membership_contract?(@contact)} title="Aktives Mitglied">
      <.icon name="hero-check-badge" class="inline-block w-[20px] text-green-800" />
    </:item>
  </.list>
</.card>

<.header level="2" class="mt-12">
  Aufnahmeanträge
</.header>

<.card>
  <%= if Enum.any?(@streams.requested_memberships.inserts) do %>
    <.table
      id="requested_memberships"
      rows={@streams.requested_memberships}
      row_click={fn {_id, membership} -> JS.navigate(~p"/memberships/#{membership}/edit") end}
    >
      <:col :let={{_id, membership}} label="In">
        <p>
          {format_string_field(Membership.get_organization(membership).name)}
        </p>
      </:col>
      <:col :let={{_id, membership}} label="Status">
        <.icon
          name={Membership.get_state_icon(membership).icon}
          class={"ml-1 inline-block w-[20px] #{Membership.get_state_icon(membership).color}"}
        />
        {get_key_for_value(Membership.get_valid_states(), membership.state)}
      </:col>

      <:action :let={{_id, membership}}>
        <.link navigate={~p"/memberships/#{membership}/edit"}>
          Antrag bearbeiten
        </.link>
      </:action>
    </.table>
  <% else %>
    <p>
      Keine Aufnahmeanträge vorhanden.
    </p>
  <% end %>

  <.link navigate={~p"/clubs/#{@club}/memberships/new?contact=#{@contact}"}>
    <.icon name="hero-plus-circle" /> Mitgliedschaft hinzufügen
  </.link>
</.card>

<.header level="2" class="mt-12">
  Mitgliedschaften & Verträge
</.header>

<.card>
  <%= if Enum.any?(@streams.contracts.inserts) do %>
    <.table
      id="contracts"
      rows={@streams.contracts}
      row_click={
        fn {_id, contract} ->
          if Contract.print_object(contract) == "Mitgliedschaft" do
            JS.navigate(~p"/memberships/#{contract.membership}/edit")
          else
            JS.navigate(~p"/contracts/#{contract}")
          end
        end
      }
    >
      <:col :let={{_id, contract}}>
        <.icon
          name={Contract.get_state_icon(contract).icon}
          class={"ml-1 inline-block w-[20px] #{Contract.get_state_icon(contract).color}"}
        />
      </:col>
      <:col :let={{_id, contract}} label="Vertragsobjekt">
        {format_string_field(Contract.print_object(contract))}
      </:col>
      <:col :let={{_id, contract}} label="Status">
        <%= if contract.membership != nil do %>
          <p class="whitespace-nowrap">
            <.icon
              name={Membership.get_state_icon(contract.membership).icon}
              class={"ml-1 inline-block w-[20px] #{Membership.get_state_icon(contract.membership).color}"}
            />
            {get_key_for_value(Membership.get_valid_states(), contract.membership.state)}
          </p>
          <p class="whitespace-nowrap">
            Art: {contract.membership.type}
          </p>
        <% else %>
          {get_key_for_value(Contract.get_valid_states(), Contract.get_state(contract))}
        <% end %>
      </:col>
      <:col :let={{_id, contract}} label="Partner">
        {format_string_field(Contract.print_partner(Contract.get_partner(contract)))}
      </:col>
      <:col :let={{_id, contract}} label="Gebühr">
        {format_string_field(contract.fee.name)}
        <%= if Fee.is_archived?(contract.fee) do %>
          <.icon name="hero-archive-box" class="ml-1 inline-block w-[20px] text-zinc-800" />
        <% end %>
      </:col>

      <:action :let={{_id, contract}}>
        <%= if Contract.print_object(contract) == "Mitgliedschaft" do %>
          <.link navigate={~p"/memberships/#{contract.membership}/edit"}>
            Mitgliedschaft bearbeiten
          </.link>
        <% else %>
          <.link navigate={~p"/contracts/#{contract}"}>Vertrag anzeigen</.link>
        <% end %>
      </:action>
    </.table>
  <% else %>
    <p>
      Bisher wurde noch kein Vertrag und noch keine Mitgliedschaft erstellt.
    </p>
  <% end %>
</.card>

<.header level="2" class="mt-12">
  Kontaktgruppen
</.header>

<.card>
  <%= if Enum.any?(@streams.contact_groups.inserts) do %>
    <.table
      id="contact_groups"
      rows={@streams.contact_groups}
      row_click={
        fn {_id, contact_groups} ->
          JS.navigate(~p"/contact_groups/#{contact_groups}")
        end
      }
    >
      <:col :let={{_id, contact_group}} label="Name">
        {format_string_field(contact_group.name)}
      </:col>
      <:col :let={{_id, contact_group}} label="Weitere Kontakte">
        {print_other_contacts_in_group(contact_group, @contact)}
      </:col>

      <:action :let={{_id, contact_group}}>
        <.link navigate={~p"/contact_groups/#{contact_group}"}>Gruppe anzeigen</.link>
      </:action>
    </.table>
  <% else %>
    <p>
      Der Kontakt ist kein Teil einer Kontaktgruppe.
    </p>
  <% end %>

  <.link navigate={~p"/clubs/#{@club}/contact_groups/new?contact=#{@contact}"}>
    <.icon name="hero-plus-circle" /> Neue Kontaktgruppe anlegen
  </.link>
</.card>
