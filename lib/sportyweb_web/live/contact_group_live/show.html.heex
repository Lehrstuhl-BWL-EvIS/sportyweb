<.header>
  Kontaktgruppe
  <:actions>
    <.link navigate={~p"/contact_groups/#{@contact_group}/edit"}>
      <.button>Kontaktgruppe bearbeiten</.button>
    </.link>
  </:actions>
</.header>

<.card>
  <.list>
    <:item title="Name">
      {format_string_field(@contact_group.name)}
    </:item>
    <:item title="Beschreibung">
      {format_string_field(@contact_group.description)}
    </:item>
  </.list>
</.card>

<.header level="2" class="mt-12">
  Mitglieder
</.header>

<.card>
  <%= if Enum.any?(@streams.contacts.inserts) do %>
    <.table
      id="contacts"
      rows={@streams.contacts}
      row_click={
        fn {_id, contact} ->
          JS.navigate(~p"/contacts/#{contact}")
        end
      }
    >
      <:col :let={{_id, contact}} label="Name">
        {format_string_field(contact.name)}
      </:col>
      <:col :let={{_id, contact}} label="Alter">
        <%= if Contact.is_person?(contact) do %>
          {Contact.age_in_years(contact)}
        <% end %>
      </:col>
      <:col :let={{_id, contact}} label="Adresse">
        {format_string_field(contact.address_as_text)}
      </:col>
      <:col :let={{_id, contact}} label="Mitgliedschaften">
        <%= if Enum.empty?(contact.memberships) do %>
          {format_string_field(nil)}
        <% else %>
          <%= for m <-  Membership.sort_by_organization_category(contact.memberships) do %>
            <p>
              <.link navigate={~p"/memberships/#{m}/edit"} class="text-indigo-600 hover:underline">
                <.icon
                  name={Membership.get_state_icon(m).icon}
                  class={"ml-1 inline-block w-[20px] #{Membership.get_state_icon(m).color}"}
                />
                {Membership.get_organization(m).name}
              </.link>
            </p>
          <% end %>
        <% end %>
      </:col>

      <:action :let={{_id, contacts}}>
        <.link navigate={~p"/contacts/#{contacts}"}>Kontakt anzeigen</.link>
      </:action>
    </.table>
  <% else %>
    <p>
      Die Kontaktgruppe enthält keine Kontakte
    </p>
  <% end %>
</.card>
