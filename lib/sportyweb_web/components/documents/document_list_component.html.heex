<div class="space-y-4">
  <%= for {group_value, docs} <- grouped_documents(@documents, @group_by_type) do %>
    <div class="bg-white rounded shadow-sm border">

      <%= if @group_by_type do %>
        <button
          type="button"
          phx-click={JS.toggle(to: "##{toggle_id(group_value)}")}
          class="w-full text-left px-3 py-2 bg-zinc-100 hover:bg-zinc-200 text-sm font-medium text-zinc-700 flex justify-between items-center rounded-t"
        >
          <span><%= label_for_group(@document_module, group_value) %></span>
          <.icon name="hero-chevron-down" class="h-4 w-4 ml-2" />
        </button>
      <% end %>

      <div id={toggle_id(group_value)} class={if @group_by_type, do: "hidden px-4 py-2", else: "px-2 py-2"}>
        <%= for doc <- docs do %>
          <div class="flex gap-4 items-center border-b last:border-none py-2">
            <img
              src={"/documents/#{doc.document.id}/thumbnail"}
              class="w-16 h-16 object-cover rounded"
            />
            <div class="flex flex-col">
              <div class="font-semibold"><%= doc.document.title %></div>
              <div class="text-sm text-gray-600"><%= doc.document.description %></div>
              <div class="text-xs text-gray-400">
                <a href={"/documents/#{doc.document.id}/file"} target="_blank" class="underline text-blue-600">
                  <%= doc.document.filename %>
                </a>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
